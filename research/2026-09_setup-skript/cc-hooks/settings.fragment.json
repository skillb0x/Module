{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(/archive/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(~/.ssh/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {"type": "command", "command": "python3",
           "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session_context.py"], "timeout": 20}
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "python3",
           "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/archive_prompt.py"], "timeout": 10}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Read|Bash|PowerShell",
        "hooks": [
          {"type": "command", "command": "python3",
           "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py"], "timeout": 10}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {"type": "command", "command": "python3",
           "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/index_journal.py"], "async": true}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "python3",
           "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/output_record.py"], "timeout": 10}
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {"type": "command", "command": "python3",
           "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/output_record.py"], "timeout": 10}
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {"type": "command", "command": "python3",
           "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/output_record.py"], "timeout": 10}
        ]
      }
    ]
  }
}
